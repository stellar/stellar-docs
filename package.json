{
  "name": "stellar-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "mint dev",
    "validate": "mint validate",
    "check:links": "pnpm -s check:site-links && pnpm -s check:skill-links",
    "check:site-links": "mint broken-links --check-anchors --check-redirects --check-snippets --files \"docs/**/*.mdx\" \"meetings/**/*.mdx\" \"snippets/**/*.mdx\" \"launch/**/*.mdx\" index.mdx sds-preview.mdx",
    "check:skill-links": "node scripts/check-skill-links.mjs",
    "check:a11y": "mint a11y",
    "check": "pnpm check:mdx && pnpm check:pad && pnpm -s rpcspec:docs --check && pnpm validate && pnpm check:links",
    "api:bundle": "pnpm bundle-horizon && pnpm bundle-anchor-platform && pnpm bundle-stellar-disbursement-platform",
    "bundle-anchor-platform": "redocly bundle ap-platform --output openapi/anchor-platform/bundled-platform.yaml && redocly bundle ap-callbacks --output openapi/anchor-platform/bundled-callbacks.yaml",
    "bundle-horizon": "redocly bundle horizon --output openapi/horizon/bundled.yml",
    "bundle-stellar-disbursement-platform": "redocly bundle stellar-disbursement-platform --output openapi/stellar-disbursement-platform/bundled.yaml",
    "check:mdx": "prettier --config .prettierrc.js -c \"{docs,meetings,snippets}/**/*.{md,mdx}\"",
    "ci-format:mdx": "prettier --config .prettierrc.js --write --log-level silent \"{docs,meetings,snippets}/**/*.{md,mdx}\"",
    "ci:mdx": "prettier --config .prettierrc.js \"{docs,meetings,snippets}/**/*.{md,mdx}\" -l --no-editorconfig",
    "diff:mdx": "pnpm ci-format:mdx && git diff -- . ':(exclude)package-lock.json' ':(exclude)package.json' ':(exclude)yarn.lock' ':(exclude)pnpm-lock.yaml' | awk \"/diff --git/ {found=1} found {print}\"",
    "pad:mdx": "node scripts/pad-component-tags.mjs $(git ls-files 'docs/*.md*' 'meetings/*.md*' 'snippets/*.md*')",
    "check:pad": "node scripts/pad-component-tags.mjs --check $(git ls-files 'docs/*.md*' 'meetings/*.md*' 'snippets/*.md*')",
    "format:mdx": "pnpm pad:mdx && prettier --config .prettierrc.js --write \"{docs,meetings,snippets}/**/*.{md,mdx}\"",
    "prepare": "husky",
    "rpcspec:build": "node openrpc/scripts/build.mjs",
    "rpcspec:docs": "node openrpc/scripts/docs.mjs",
    "rpcspec:check": "node openrpc/scripts/build.mjs && git diff --exit-code -- \"*.openrpc.json\" && node openrpc/scripts/docs.mjs --check",
    "rpcspec:validate": "node openrpc/scripts/build.mjs && node openrpc/scripts/validate.mjs",
    "stellar-cli:build": "node scripts/stellar_cli.mjs"
  },
  "dependencies": {
    "@json-schema-tools/reference-resolver": "1.3.0",
    "@open-rpc/schema-utils-js": "^2.2.1",
    "fs-extra": "^11.4.1",
    "json-schema-merge-allof": "^0.8.1",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@redocly/cli": "^2.75.0",
    "@stellar/prettier-config": "^1.2.0",
    "husky": "^9.1.7",
    "mint": "^4.2.1203",
    "prettier": "^3.9.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
}
